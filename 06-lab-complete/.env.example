
# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Security — BẮT BUỘC thay trong production
AGENT_API_KEY=dev-key-change-me-in-production

# LLM Provider (chọn 1 trong các options dưới)

# Option 1: Custom LLM (OpenAI-compatible, e.g. opencode.ai)
LLM_PROVIDER=custom
LLM_MODEL=deepseek-v4-flash
CUSTOM_LLM_MODEL=deepseek-v4-flash
CUSTOM_LLM_BASE_URL=https://opencode.ai/zen/go/v1
CUSTOM_LLM_API_KEY=

# Option 2: Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=

# Option 3: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Option 4: OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=deepseek/deepseek-chat
# OPENROUTER_API_KEY=

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4

# Rate & Budget─
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=10.0

